{
  "name": "@tomaks28/yespark-ts-sdk",
  "version": "1.1.1",
  "description": "Fetch-based TypeScript SDK for the Yespark Group Partner API",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "reserve": "npx tsx scripts/cli.ts",
    "generate": "openapi-typescript api.json -o src/generated/schema.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "npm publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.6.0",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0"
  }
}
