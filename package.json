{
  "name": "@tomaks28/yespark-ts-sdk",
  "version": "1.2.0",
  "description": "Fetch-based TypeScript SDK for the Yespark Group Partner API",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "reserve": "npx tsx scripts/cli.ts",
    "generate": "openapi-typescript api.json -o src/generated/schema.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run generate && npm run build:esm && npm run build:cjs && npm run build:manifests",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:manifests": "echo '{\"type\":\"module\"}' > dist/esm/package.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "npm publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.7.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0"
  }
}
