{
  "name": "@tomaks28/yespark-ts-sdk",
  "version": "1.1.0",
  "description": "Fetch-based TypeScript SDK for the Yespark Group Partner API",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "reserve": "npx tsx scripts/cli.ts",
    "generate": "openapi-typescript api.json -o src/generated/schema.ts",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "release": "npm publish"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/node": "^22.20.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "js-yaml": "^4.3.0"
  }
}
